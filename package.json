{
  "name": "dissonance-core",
  "version": "0.0.2",
  "main": "index.js",
  "gypfile": true,
  "scripts": {
    "build": "node scripts/build-addon.js",
    "build:addon": "npm run build",
    "build:addon:dist": "npm run build:addon && node scripts/prepare-artifact.js",
    "build:cli:debug": "node scripts/build-cli.js --config=Debug",
    "build:cli:release": "node scripts/build-cli.js --config=Release",
    "build:local": "npm run build:addon:dist && npm run build:cli:debug",
    "test": "node --test tests/addon/addon.test.js",
    "coverage": "npm run coverage:build && npm run coverage:test && gcovr cmake-build-coverage",
    "coverage:build": "cmake -S . -B cmake-build-coverage -DENABLE_COVERAGE=ON -DCMAKE_BUILD_TYPE=Debug -DBUILD_NODE_ADDON=ON -DBUILD_CLI=ON && cmake --build cmake-build-coverage --parallel",
    "coverage:test": "ctest --test-dir cmake-build-coverage --output-on-failure --no-tests=error && DISSONANCE_CORE_ADDON=cmake-build-coverage/dissonance_core.node npm test",
    "format:cpp": "node scripts/clang-format.js",
    "format:cpp:check": "node scripts/clang-format.js --check",
    "cppcheck": "node scripts/cppcheck.js"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0"
  }
}
