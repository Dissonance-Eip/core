{
  "name": "dissonance-core",
  "version": "0.0.2",
  "main": "index.js",
  "gypfile": true,
  "scripts": {
    "build": "node scripts/build-addon.js",
    "build:addon": "npm run build",
    "build:addon:dist": "npm run build:addon && node scripts/prepare-artifact.js",
    "build:cli:debug": "node scripts/build-cli.js --config=Debug",
    "build:cli:release": "node scripts/build-cli.js --config=Release",
    "build:local": "npm run build:addon:dist && npm run build:cli:debug",
    "test": "echo \"JS tests removed — DSP covered by CTest\"",
    "format:cpp": "node scripts/clang-format.js",
    "format:cpp:check": "node scripts/clang-format.js --check",
    "cppcheck": "node scripts/cppcheck.js"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "node-gyp": "^12.1.0"
  }
}
